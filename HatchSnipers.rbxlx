local function makeSpinTile(skin, x)
	local t = Instance.new("Frame")
	t.Size = UDim2.new(0, TILE_W - 8, 1, 0)
	t.Position = UDim2.new(0, x, 0, 0)
	t.BackgroundColor3 = C.panel2
