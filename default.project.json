{
  "name": "BambooSlasher",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "StreamingEnabled": true }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$className": "Folder",
        "Balance":  { "$path": "src/Shared/Balance.lua" },
        "UITheme":  { "$path": "src/Shared/UITheme.lua" },
        "Layers":   { "$path": "src/Shared/Layers.lua" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/Server/Server.server.lua" },
      "Services": {
        "$className": "Folder",
        "DataService":    { "$path": "src/Server/Services/DataService.lua" },
        "WorldGenerator": { "$path": "src/Server/Services/WorldGenerator.lua" },
        "WorldService":   { "$path": "src/Server/Services/WorldService.lua" },
        "StatService":    { "$path": "src/Server/Services/StatService.lua" },
        "HubService":     { "$path": "src/Server/Services/HubService.lua" },
        "MonsterService": { "$path": "src/Server/Services/MonsterService.lua" },
        "CombatService":  { "$path": "src/Server/Services/CombatService.lua" },
        "ForgeService":   { "$path": "src/Server/Services/ForgeService.lua" },
        "RebirthService": { "$path": "src/Server/Services/RebirthService.lua" },
        "ArenaService":   { "$path": "src/Server/Services/ArenaService.lua" }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/Client/Client.client.lua" },
        "Controllers": {
          "$className": "Folder",
          "EffectsController": { "$path": "src/Client/Controllers/EffectsController.lua" },
          "UIController":      { "$path": "src/Client/Controllers/UIController.lua" },
          "InputController":   { "$path": "src/Client/Controllers/InputController.lua" }
        }
      }
    }
  }
}
